# ==============================================================================
# BlackHawk Tournament API - Server Environment Variables Template
# ==============================================================================
# CRITICAL SECURITY NOTE:
# The Supabase service-role key previously committed to git history must be rotated
# immediately in https://supabase.com/dashboard/project/_/settings/api prior to production!
# ==============================================================================

# Server Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Allowed CORS Origins (comma-separated, e.g. "https://blackhawk.gg,https://admin.blackhawk.gg")
CORS_ORIGIN=

# Supabase PostgreSQL Service-Role Configuration (Server-Only, Never expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Initial Master Admin Credentials (optional environment seed)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Discord OAuth2 & Server Membership Verification
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=

# Security Controls
ENABLE_DEMO_AUTH=false
COOKIE_SECRET=
