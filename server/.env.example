# ==============================================================================
# BlackHawk Tournament API - Server Environment Variables Template
# ==============================================================================

# Server Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Allowed CORS Origins (comma-separated for multiple, e.g. "https://my-app.vercel.app,http://localhost:5173")
CORS_ORIGIN=*

# Supabase PostgreSQL Realtime Database Configuration
# Obtain from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Initial Admin Credentials (Optional, leave blank if disabled)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Legacy Firebase (Optional Source for scripts/migrate-firebase-to-supabase.ts)
FIREBASE_DATABASE_URL=https://blackhawk-tournament-default-rtdb.asia-southeast1.firebasedatabase.app/
VITE_FIREBASE_DATABASE_URL=https://blackhawk-tournament-default-rtdb.asia-southeast1.firebasedatabase.app/
VITE_FIREBASE_PROJECT_ID=blackhawk-tournament

# Discord OAuth2 & Server Membership Verification
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:5173/discord-callback
