# BlackHawk Tournament - Supabase PostgreSQL Realtime Configuration
# Get these credentials from your Supabase Project Settings > API: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Legacy Firebase (Optional Fallback / Data Migration Source)
VITE_FIREBASE_DATABASE_URL=https://blackhawk-tournament-default-rtdb.asia-southeast1.firebasedatabase.app/
VITE_FIREBASE_PROJECT_ID=blackhawk-tournament

# Discord OAuth2 & Server Membership Verification
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:5173/discord-callback
